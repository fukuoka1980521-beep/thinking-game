{
  "schema_version": "1.0",
  "required_fields": [
    "timestamp",
    "state_version",
    "target",
    "open_id",
    "route_id",
    "model_action",
    "risk_class",
    "controller_result",
    "controller_reason",
    "hard_block",
    "shadow_only",
