{
  "version": "Study-B-Calibration-v0.2",
  "primary_construct": "structured evidence-weighting / interpretation profile",
  "fields": {
    "conclusion": ["SUPPORTS_MOST", "DOES_NOT_SUPPORT_MOST", "INCONCLUSIVE"],
    "attribution_percent": "integer 0-100; best estimate of percent of the raw observed gap attributable to the target factor",
    "attribution_interval_low": "integer 0-100",
    "attribution_interval_high": "integer 0-100",
    "confidence": "integer 0-100",
    "evidence_impacts": {
      "E1": "integer -2..2",
      "E2": "integer -2..2",
      "E3": "integer -2..2",
      "E4": "integer -2..2",
      "E5": "integer -2..2",
      "E6": "integer -2..2",
      "E7": "integer -2..2",
      "E8": "integer -2..2"
    },
    "decisive_evidence_ids": "1-3 unique values E1-E8",
    "next_action": ["ACCEPT_TARGET_FOR_NOW", "REJECT_TARGET_FOR_NOW", "COLLECT_MORE_EVIDENCE"]
  },
  "impact_scale": {
    "-2": "strongly weighs against target claim",
    "-1": "modestly weighs against target claim",
    "0": "neutral, ambiguous, or not directionally informative",
    "1": "modestly supports target claim",
    "2": "strongly supports target claim"
  },
  "primary_vector": {
    "conclusion_one_hot": 3,
    "next_action_one_hot": 3,
    "attribution_point_low_high_scaled": 3,
    "confidence_scaled": 1,
    "evidence_impacts_scaled": 8,
    "decisive_evidence_binary": 8,
    "total_dimensions": 26
  },
  "primary_classifier": "L2-normalized 26-dimensional vector + cosine nearest-centroid; train on one packet and test on the other"
}
